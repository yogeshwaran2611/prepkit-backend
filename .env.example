# ---- LLM (free tier, no credit card) --------------------------------------
# Create a key with a Google account, no billing setup: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Measured on the live free tier — see the model table in the README.
# gemini-2.5-flash returns 404 "no longer available to new users" for new keys.
# gemini-3.6-flash is a thinking model: ~29s/call and frequent 503s.
GEMINI_MODEL=gemini-3.1-flash-lite

# Free tiers cap TOKENS per minute, not just requests. Size these from the output of
# `npm run probe:models` rather than guessing. Blank means no client-side limit.
LLM_TPM=
LLM_RPM=
LLM_CONCURRENCY=2

# ---- Datastore ------------------------------------------------------------
# Unset = a local JSON file store (.data/prepkit.json), so a clean clone runs with no
# services installed. Set it to use MongoDB, which is the deployment path.
MONGODB_URI=
MONGODB_DB=prepkit

# ---- Auth / session -------------------------------------------------------
# 32+ random bytes. The API refuses to start in production without a real value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000

# same-site: web and api under one apex domain (preferred). Cookie is SameSite=Lax.
# cross-site: raw platform subdomains (e.g. *.vercel.app + *.fly.dev). Cookie becomes
#   SameSite=None; Secure, and mutating requests require an allowlisted Origin.
# Getting this wrong means local dev works and production is silently logged out.
COOKIE_MODE=same-site
COOKIE_DOMAIN=

# Comma-separated. A wildcard is never accepted: it is illegal with credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Retrieval / security -------------------------------------------------
# EVAL AND DEV ONLY. Permits loopback, private ranges and non-standard ports, which is what
# makes Appendix B's http://localhost:8099/acme/ crawlable. MUST stay unset in production —
# the API logs a warning if it is set there.
ALLOW_PRIVATE_URLS=true

# Whole-run page budget, shared by the site crawl, hiring pages and search results.
FETCH_MAX_PAGES=16

# Optional. Keyless engines (DuckDuckGo, Mojeek) are usually bot-blocked from server IPs.
# A free Brave Search key makes public-discussion search reliable; without it the pipeline
# still runs and honestly reports NO_PUBLIC_DISCUSSION.
# https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
JOB_CONCURRENCY=2

# ---- Web ------------------------------------------------------------------
# Where the browser reaches the API. Must be the API's PUBLIC url in deployment.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Probes (tools/probes) -----------------------------------------------
API=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
