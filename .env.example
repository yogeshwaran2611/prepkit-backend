# ---- LLM (free tier, no credit card) --------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback provider, used when Gemini 429s or hits its daily cap (§7)
GROQ_API_KEY=
LLM_PROVIDER=auto          # auto | gemini | groq
# Size these from `npm run probe:budget` output, NOT from a guess (§7)
LLM_TPM=                   # tokens per minute the bucket may spend
LLM_RPM=                   # requests per minute

# ---- Datastore ------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=prepkit

# ---- Auth / session (§8) --------------------------------------------------
JWT_SECRET=                # 32+ random bytes
COOKIE_MODE=same-site      # same-site (both under one apex domain) | cross-site
COOKIE_DOMAIN=             # e.g. .example.com in same-site mode; blank in cross-site
CORS_ORIGINS=http://localhost:3000   # comma-separated, no wildcard

# ---- Retrieval / security (§8) -------------------------------------------
# EVAL ONLY: permits loopback, private ranges and non-standard ports so that
# Appendix B's http://localhost:8099/acme/ is crawlable. MUST stay unset in production.
ALLOW_PRIVATE_URLS=
FETCH_MAX_PAGES=16         # whole-run budget shared by crawl + hiring + search (§4.3.1)

# ---- Probes (tools/probes) -----------------------------------------------
API=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# ---- Optional: better public-discussion search ---------------------------
# Keyless engines (DuckDuckGo, Marginalia) are frequently bot-blocked from server IPs.
# A free Brave Search API key makes S4 reliable. Without it the pipeline still runs and
# honestly reports NO_PUBLIC_DISCUSSION. https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
